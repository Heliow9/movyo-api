# URL da API usada pelo app Movyo Garçom.
# Em desenvolvimento local, use por exemplo: http://SEU_IP_DA_REDE:10000
EXPO_PUBLIC_API_URL=https://api.movyo.delivery

# Sessao do restaurante: acesso curto e renovacao automatica mais longa.
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MySQL DATETIME operacional da Movyo (Brasil)
MYSQL_TIMEZONE=-03:00
MOVYO_TZ_OFFSET_MINUTES=-180

# Web Push do Movyo Hub (PWA iOS/Android/Desktop)
# Gere uma única vez com: npm run push:generate-keys
WEB_PUSH_SUBJECT=mailto:suporte@movyo.delivery
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_TTL_SECONDS=120
WEB_PUSH_MAX_FAILURES=5
WEB_PUSH_DEDUP_TTL_MS=20000

# IA do cadastro de produtos (somente no servidor; nunca coloque esta chave no Electron/Vite)
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
GROQ_REQUESTS_PER_MINUTE=20
GROQ_REQUESTS_PER_DAY=300
GROQ_TIMEOUT_MS=12000
GROQ_AUDIO_TIMEOUT_MS=30000
GROQ_CACHE_TTL_MS=86400000
